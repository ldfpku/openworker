.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/
.coverage

# Generated at packaging time by packaging/write_version.py (stamped from
# surfaces/gui/src-tauri/tauri.conf.json) — never hand-edited, never committed.
coworker/_version.py

# Local secrets (live-smoke BYO keys) — never committed. Cover every .env variant
# (.env.local, .env.production, …) so a future one can't slip in; keep the shipped
# template (.env.example) tracked.
.env
.env.*
!.env.example
# The real relay roster: colleagues' names and personal mailboxes. This fork is PUBLIC,
# so the filled-in roster stays on the admin's machine — only roster.example.csv ships.
gemini-relay/scripts/roster.csv

# Throwaway local diagnostics (probe scripts, one-off dumps) — never committed.
/scratch/
.claude/settings.local.json

# 桌面应用落到仓库目录里的会话附件
/Claude outputs/
.tools/

/.kimi-tmp/
/.task-assets/
