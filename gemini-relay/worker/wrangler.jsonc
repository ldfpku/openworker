{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gemini-relay",
	// Deployed on the ZY account since the 2026-10-14 restore. The account id is deliberately
	// NOT written here (this repository is public): deploy with CLOUDFLARE_ACCOUNT_ID and
	// CLOUDFLARE_API_TOKEN set for ZY in that command's environment only. (KV and D1 ids are
	// account-scoped, so a deploy under the machine's own wrangler login — bound to the old
	// DF account — should be refused for the bindings below rather than land there; that
	// path was reasoned, not tried.)
	"main": "src/index.ts",
	"compatibility_date": "2026-08-01",
	// workers.dev is DNS-poisoned in mainland China and would expose a second, uncontrolled
	// hostname — serve exclusively on the custom domain.
	"workers_dev": false,
	"routes": [
		{
			"pattern": "gemini.smjtools.com",
			"custom_domain": true
		}
	],
	// Cloudflare Access (Zero Trust) coordinates for the One-time PIN application that
	// guards gemini.smjtools.com/login. Neither is a secret — the team domain is in every
	// login redirect and the AUD tag is in every issued token — so they live here, not in
	// `wrangler secret`. Fill both in from docs/08-Access登录配置.md before deploying.
	"vars": {
		// ZY team. The AUD is the ZY application `gemini-relay-login` (id e8f13b5b-…,
		// gemini.smjtools.com/login/*, created 2026-10-14); the old DF AUD must never be
		// accepted here.
		"ACCESS_TEAM_DOMAIN": "https://zy-smj.cloudflareaccess.com",
		"ACCESS_AUD": "eabac4064bb8874be8a6e1df03aac76ce38ba084db2a3f5d6c0b69fd6c74c46c",
		// House default ceilings, per person per window (worker/src/quota.ts). A roster entry
		// may override any of them; -1 disables a ceiling, 0 suspends the person entirely.
		// These are the numbers everyone gets unless roster.csv says otherwise, so they are
		// sized for a person driving an agent by hand — one agentic turn with tool calls is
		// easily 10-20 requests — not for one chat message.
		"QUOTA_RPM": "30",
		"QUOTA_RPD": "1200",
		"QUOTA_TPD": "5000000"
	},
	// This Worker holds NO secrets. Every caller presents their own Google key in
	// x-goog-api-key and it is forwarded untouched, so there is nothing here to leak and
	// nothing to rotate. (v3 briefly had a shared GEMINI_API_KEY secret; if this deployment
	// still has one, `npx wrangler secret delete GEMINI_API_KEY` — it is now unused.)
	//
	// Nightly at 03:17 UTC = 11:17 Beijing: drop quota buckets older than three days. Off
	// hours would be nicer, but Cloudflare cron triggers are UTC-only and the job is a single
	// indexed DELETE.
	"triggers": {
		"crons": [
			"17 3 * * *"
		]
	},
	"kv_namespaces": [
		{
			// ZY `ROSTER-smjtools-migration` — the roster copied from DF on 2026-10-03, shared
			// with claude-relay and kept in step with help.smjtools.com/admin (RELAY_ROSTER).
			"binding": "ROSTER",
			"id": "51a35aba347f40f1a511a41f1220c033"
		}
	],
	// schema changes go through migrations/:
	//   npx wrangler d1 migrations apply gemini_relay_usage --remote
	"d1_databases": [
		{
			"binding": "USAGE_DB",
			"database_name": "gemini_relay_usage",
			"database_id": "69aed1fc-7a1d-4dfc-8fe4-0852ee7c106c",
			"migrations_dir": "migrations"
		}
	]
}
